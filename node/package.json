{
  "name": "@aws/developer-toolkit-elasticache",
  "version": "0.1.0-dev.0",
  "description": "Developer toolkit for Amazon ElastiCache",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "supportedNodeVersions": [
    "22.x",
    "24.x"
  ],
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "list-supported-versions": "node scripts/list-supported-versions.mjs",
    "package:check": "npm run clean && npm run build && npm pack --dry-run",
    "test": "npm run build && npm run build:test && node --test dist-test/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/credential-providers": "^3.943.0",
    "@smithy/core": "^3.18.0",
    "@smithy/hash-node": "^4.2.7",
    "@smithy/signature-v4": "^5.2.7",
    "@smithy/types": "^4.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
